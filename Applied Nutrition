    // Initialize Quiz
    function initQuiz() {
      startTimer();
      renderNavGrid();
      loadQuestion(currentIndex);
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        timerSeconds++;
        const mins = String(Math.floor(timerSeconds / 60)).padStart(2, '0');
        const secs = String(timerSeconds % 60).padStart(2, '0');
        document.getElementById('timerDisplay').innerText = `${mins}:${secs}`;
      }, 1000);
    }

    function setMode(mode) {
      currentMode = mode;
      document.getElementById('studyModeBtn').classList.toggle('active', mode === 'study');
      document.getElementById('examModeBtn').classList.toggle('active', mode === 'exam');
      loadQuestion(currentIndex);
    }

    function renderNavGrid() {
      const grid = document.getElementById('navGrid');
      grid.innerHTML = '';
      questions.forEach((q, idx) => {
        const dot = document.createElement('button');
        dot.className = 'nav-dot';
        dot.id = `navDot_${idx}`;
        dot.innerText = idx + 1;
        dot.onclick = () => {
          currentIndex = idx;
          loadQuestion(currentIndex);
        };
        grid.appendChild(dot);
      });
      updateNavGridState();
    }

    function updateNavGridState() {
      questions.forEach((q, idx) => {
        const dot = document.getElementById(`navDot_${idx}`);
        if (!dot) return;
        dot.className = 'nav-dot';
        if (idx === currentIndex) dot.classList.add('current');
        if (flaggedQuestions.has(idx)) dot.classList.add('flagged');

        if (userAnswers[idx] !== null) {
          if (currentMode === 'study') {
            if (userAnswers[idx] === q.correct) dot.classList.add('correct');
            else dot.classList.add('incorrect');
          } else {
            dot.classList.add('answered');
          }
        }
      });

      const answeredCount = userAnswers.filter(a => a !== null).length;
      document.getElementById('answeredCount').innerText = `${answeredCount}/${questions.length}`;
      const pct = (answeredCount / questions.length) * 100;
      document.getElementById('progressFill').style.width = `${pct}%`;
    }

    function loadQuestion(index) {
      const q = questions[index];
      document.getElementById('currentNum').innerText = index + 1;
      document.getElementById('qCategory').innerText = categoryMap[q.id] || "Psychology";
      document.getElementById('qText').innerText = q.question;

      // Flag button state
      const flagBtn = document.getElementById('flagBtn');
      const isFlagged = flaggedQuestions.has(index);
      flagBtn.classList.toggle('flagged', isFlagged);
      document.getElementById('flagText').innerText = isFlagged ? 'Flagged' : 'Flag for Review';

      // Options
      const container = document.getElementById('optionsContainer');
      container.innerHTML = '';

      const letters = ['A', 'B', 'C', 'D'];
      const isAnswered = userAnswers[index] !== null;

      q.options.forEach((opt, optIdx) => {
        const optDiv = document.createElement('div');
        optDiv.className = 'option-item';
        
        let extraClasses = [];
        if (userAnswers[index] === optIdx) {
          extraClasses.push('selected');
        }

        if (currentMode === 'study' && isAnswered) {
          optDiv.classList.add('disabled');
          if (optIdx === q.correct) {
            optDiv.classList.add('correct');
          } else if (userAnswers[index] === optIdx) {
            optDiv.classList.add('incorrect');
          }
        } else if (userAnswers[index] === optIdx) {
          optDiv.classList.add('selected');
        }

        optDiv.innerHTML = `<span class="opt-letter">${letters[optIdx]}</span><span>${opt}</span>`;
        optDiv.onclick = () => selectOption(optIdx);
        container.appendChild(optDiv);
      });

      // Explanation box (Study mode)
      const expBox = document.getElementById('explanationBox');
      if (currentMode === 'study' && isAnswered) {
        expBox.style.display = 'block';
        const isCorrect = userAnswers[index] === q.correct;
        expBox.className = `explanation-box ${isCorrect ? 'correct' : 'incorrect'}`;
        document.getElementById('explanationTitle').innerText = isCorrect ? '✓ Correct Rationale:' : '✗ Incorrect Rationale:';
        document.getElementById('explanationText').innerText = q.explanation;
      } else {
        expBox.style.display = 'none';
      }

      // Toolbar Buttons
      document.getElementById('prevBtn').disabled = (index === 0);
      const isLast = (index === questions.length - 1);
      document.getElementById('nextBtn').style.display = isLast ? 'none' : 'inline-flex';
      document.getElementById('finishBtn').style.display = isLast ? 'inline-flex' : 'none';

      updateNavGridState();
    }

    function selectOption(optIdx) {
      if (currentMode === 'study' && userAnswers[currentIndex] !== null) return;
      userAnswers[currentIndex] = optIdx;
      loadQuestion(currentIndex);
    }

    function clearCurrentAnswer() {
      userAnswers[currentIndex] = null;
      loadQuestion(currentIndex);
    }

    function toggleFlag() {
      if (flaggedQuestions.has(currentIndex)) {
        flaggedQuestions.delete(currentIndex);
      } else {
        flaggedQuestions.add(currentIndex);
      }
      loadQuestion(currentIndex);
    }

    function navigate(delta) {
      const newIdx = currentIndex + delta;
      if (newIdx >= 0 && newIdx < questions.length) {
        currentIndex = newIdx;
        loadQuestion(currentIndex);
      }
    }

